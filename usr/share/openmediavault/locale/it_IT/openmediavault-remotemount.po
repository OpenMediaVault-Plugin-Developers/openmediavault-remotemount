msgid "SMB/CIFS"
msgstr "SMB/CIFS"

msgid ""
"SMB/CIFS or NFS — hostname or IP.<br/>WebDAV (davfs) — full URL (e.g. "
"https://example.com/dav).<br/>S3 — endpoint URL (blank for "
"AWS).<br/>SFTP/FTP — hostname[:port].<br/>Google Drive/OneDrive — name of a "
"pre-configured rclone remote (run rclone config first)."
msgstr ""
"SMB/CIFS o NFS — nome host o IP.<br/>WebDAV (davfs) — URL completo (es. "
"https://example.com/dav).<br/>S3 — URL dell'endpoint (vuoto per "
"AWS).<br/>SFTP/FTP — nome host[:porta].<br/>Google Drive/OneDrive — nome di "
"un remoto rclone preconfigurato (eseguire prima rclone config)."

msgid ""
"SMB/CIFS or WebDAV — password (leave blank for guest)<br>S3 — secret access "
"key<br/>SFTP/FTP — password (auto-obscured on save)."
msgstr ""
"SMB/CIFS o WebDAV — password (lasciare vuoto per gli utenti guest)<br>S3 — "
"chiave di accesso segreta<br/>SFTP/FTP — password (oscurata automaticamente "
"al salvataggio)."

msgid ""
"SMB/CIFS or WebDAV — username (leave blank for guest)<br/>S3 — access key "
"ID<br/>SFTP/FTP — username."
msgstr ""
"SMB/CIFS o WebDAV — nome utente (lasciare vuoto per gli utenti guest)<br/>S3"
" — ID chiave di accesso<br/>SFTP/FTP — nome utente."

msgid ""
"SMB/CIFS see <a href='https://linux.die.net/man/8/mount.cifs' "
"target='_blank'>mount.cifs</a><br/>NFS see <a "
"href='https://linux.die.net/man/8/mount.nfs' "
"target='_blank'>mount.nfs</a><br/>WebDAV see <a "
"href='https://linux.die.net/man/8/mount.davfs' "
"target='_blank'>mount.davfs</a><br/>rclone — extra mount flags (e.g. --vfs-"
"cache-mode=writes)."
msgstr ""
"Per SMB/CIFS vedi <a href='https://linux.die.net/man/8/mount.cifs' "
"target='_blank'>mount.cifs</a><br/>Per NFS vedi <a "
"href='https://linux.die.net/man/8/mount.nfs' "
"target='_blank'>mount.nfs</a><br/>Per WebDAV vedi <a "
"href='https://linux.die.net/man/8/mount.davfs' "
"target='_blank'>mount.davfs</a><br/>rclone — flag di montaggio aggiuntivi "
"(es. --vfs-cache-mode=writes)."

msgid ""
"SMB/CIFS — share name<br/>NFS — export path<br/>S3 — bucket "
"name<br/>SFTP/FTP — remote directory path<br/>WebDAV — subdirectory "
"(optional)<br/>Drive/OneDrive — folder path (optional)"
msgstr ""
"SMB/CIFS — nome della condivisione<br/>NFS — percorso di export<br/>S3 — "
"nome del bucket<br/>SFTP/FTP — percorso della directory remota<br/>WebDAV — "
"sottodirectory (opzionale)<br/>Drive/OneDrive — percorso della cartella "
"(opzionale)"

