msgid "SMB/CIFS"
msgstr "SMB/CIFS"

msgid ""
"SMB/CIFS or NFS — hostname or IP.<br/>WebDAV (davfs) — full URL (e.g. "
"https://example.com/dav).<br/>S3 — endpoint URL (blank for "
"AWS).<br/>SFTP/FTP — hostname[:port].<br/>Google Drive/OneDrive — name of a "
"pre-configured rclone remote (run rclone config first)."
msgstr ""
"SMB/CIFS eller NFS – värdnamn eller IP-adress.<br/>WebDAV (davfs) – "
"fullständig webbadress (t.ex. https://example.com/dav).<br/>S3 – "
"slutpunktsadress (lämna tomt för AWS).<br/>SFTP/FTP – "
"värdnamn[:port].<br/>Google Drive/OneDrive – namnet på en förkonfigurerad "
"rclone-fjärranslutning (kör först rclone config)."

msgid ""
"SMB/CIFS or WebDAV — password (leave blank for guest)<br>S3 — secret access "
"key<br/>SFTP/FTP — password (auto-obscured on save)."
msgstr ""
"SMB/CIFS eller WebDAV – lösenord (lämna tomt för gäståtkomst)<br>S3 – hemlig"
" åtkomstnyckel<br/>SFTP/FTP – lösenord (döljs automatiskt när det sparas)."

msgid ""
"SMB/CIFS or WebDAV — username (leave blank for guest)<br/>S3 — access key "
"ID<br/>SFTP/FTP — username."
msgstr ""
"SMB/CIFS eller WebDAV – användarnamn (lämna tomt för gäståtkomst)<br/>S3 – "
"åtkomstnyckel-ID<br/>SFTP/FTP – användarnamn."

msgid ""
"SMB/CIFS see <a href='https://linux.die.net/man/8/mount.cifs' "
"target='_blank'>mount.cifs</a><br/>NFS see <a "
"href='https://linux.die.net/man/8/mount.nfs' "
"target='_blank'>mount.nfs</a><br/>WebDAV see <a "
"href='https://linux.die.net/man/8/mount.davfs' "
"target='_blank'>mount.davfs</a><br/>rclone — extra mount flags (e.g. --vfs-"
"cache-mode=writes)."
msgstr ""
"För SMB/CIFS, se <a href='https://linux.die.net/man/8/mount.cifs' "
"target='_blank'>mount.cifs</a><br/>För NFS, se <a "
"href='https://linux.die.net/man/8/mount.nfs' "
"target='_blank'>mount.nfs</a><br/>För WebDAV, se <a "
"href='https://linux.die.net/man/8/mount.davfs' "
"target='_blank'>mount.davfs</a><br/>rclone – extra monteringsflaggor (t.ex. "
"--vfs-cache-mode=writes)."

msgid ""
"SMB/CIFS — share name<br/>NFS — export path<br/>S3 — bucket "
"name<br/>SFTP/FTP — remote directory path<br/>WebDAV — subdirectory "
"(optional)<br/>Drive/OneDrive — folder path (optional)"
msgstr ""
"SMB/CIFS – resursnamn<br/>NFS – exportsökväg<br/>S3 – "
"bucketnamn<br/>SFTP/FTP – sökväg till fjärrmapp<br/>WebDAV – undermapp "
"(valfritt)<br/>Drive/OneDrive – mappsökväg (valfritt)"

