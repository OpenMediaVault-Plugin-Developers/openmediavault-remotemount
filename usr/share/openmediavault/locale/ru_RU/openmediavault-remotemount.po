msgid "SMB/CIFS"
msgstr "SMB/CIFS"

msgid ""
"SMB/CIFS or NFS — hostname or IP.<br/>WebDAV (davfs) — full URL (e.g. "
"https://example.com/dav).<br/>S3 — endpoint URL (blank for "
"AWS).<br/>SFTP/FTP — hostname[:port].<br/>Google Drive/OneDrive — name of a "
"pre-configured rclone remote (run rclone config first)."
msgstr ""
"SMB/CIFS или NFS — имя хоста или IP.<br/>WebDAV (davfs) — полный URL "
"(например, https://example.com/dav).<br/>S3 — URL конечной точки (пусто для "
"AWS).<br/>SFTP/FTP — имя хоста[:порт].<br/>Google Drive/OneDrive — имя "
"предварительно настроенного удалённого ресурса rclone (сначала выполните "
"rclone config)."

msgid ""
"SMB/CIFS or WebDAV — password (leave blank for guest)<br>S3 — secret access "
"key<br/>SFTP/FTP — password (auto-obscured on save)."
msgstr ""
"SMB/CIFS или WebDAV — пароль (оставьте пустым для гостя)<br>S3 — секретный "
"ключ доступа<br/>SFTP/FTP — пароль (при сохранении автоматически "
"скрывается)."

msgid ""
"SMB/CIFS or WebDAV — username (leave blank for guest)<br/>S3 — access key "
"ID<br/>SFTP/FTP — username."
msgstr ""
"SMB/CIFS или WebDAV — имя пользователя (оставьте пустым для гостя)<br/>S3 — "
"идентификатор ключа доступа<br/>SFTP/FTP — имя пользователя."

msgid ""
"SMB/CIFS see <a href='https://linux.die.net/man/8/mount.cifs' "
"target='_blank'>mount.cifs</a><br/>NFS see <a "
"href='https://linux.die.net/man/8/mount.nfs' "
"target='_blank'>mount.nfs</a><br/>WebDAV see <a "
"href='https://linux.die.net/man/8/mount.davfs' "
"target='_blank'>mount.davfs</a><br/>rclone — extra mount flags (e.g. --vfs-"
"cache-mode=writes)."
msgstr ""
"SMB/CIFS см. <a href='https://linux.die.net/man/8/mount.cifs' "
"target='_blank'>mount.cifs</a><br/>NFS см. <a "
"href='https://linux.die.net/man/8/mount.nfs' "
"target='_blank'>mount.nfs</a><br/>WebDAV см. <a "
"href='https://linux.die.net/man/8/mount.davfs' "
"target='_blank'>mount.davfs</a><br/>rclone — дополнительные флаги "
"монтирования (например, --vfs-cache-mode=writes)."

msgid ""
"SMB/CIFS — share name<br/>NFS — export path<br/>S3 — bucket "
"name<br/>SFTP/FTP — remote directory path<br/>WebDAV — subdirectory "
"(optional)<br/>Drive/OneDrive — folder path (optional)"
msgstr ""
"SMB/CIFS — имя общего ресурса<br/>NFS — путь экспорта<br/>S3 — имя "
"корзины<br/>SFTP/FTP — путь к каталогу на удалённом сервере<br/>WebDAV — "
"подкаталог (необязательно)<br/>Drive/OneDrive — путь к папке (необязательно)"

